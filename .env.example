# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# 32+ random bytes. Required in production.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true if behind a reverse proxy/CDN (so x-forwarded-for is trusted).
# TRUST_PROXY=false
# TRUST_PROXY_HOPS=1

# Comma-separated list of enabled payment methods.
# Valid options: cod, bank_transfer, gift_card. `card` is not implemented yet.
# PAYMENT_METHODS_ENABLED=cod,bank_transfer,gift_card

# Seed script passwords (development only).
# SEED_ADMIN_PASSWORD=
# SEED_SUPPORT_PASSWORD=
# SEED_CLIENT_PASSWORD=

# Set to 1 to allow seed against NODE_ENV=production (wipes all tables).
# ALLOW_DESTRUCTIVE_SEED=

# ── E-mail transactionnel (Resend) ─────────────────────────────────
# Clé API **serveur** : ne jamais préfixer par NEXT_PUBLIC_, sinon elle
# serait embarquée dans le JavaScript envoyé au navigateur.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
#
# Expéditeur affiché. Tant que le domaine n'est pas vérifié dans Resend,
# utiliser onboarding@resend.dev (n'envoie alors qu'au propriétaire du compte).
# EMAIL_FROM="Cléopâtre — Espace Santé Beauté <onboarding@resend.dev>"
# EMAIL_REPLY_TO=
#
# Secret protégeant /api/cron/abandoned-carts. À renseigner impérativement,
# sinon la tâche planifiée refuse toute exécution (401).
# Générer avec : openssl rand -hex 24
# CRON_SECRET=
#
# Délai avant qu'un panier inactif soit considéré comme abandonné (secondes).
# 60 s facilite les tests ; compter plutôt 3600 (1 h) en production.
# ABANDONED_CART_DELAY_SECONDS=60
